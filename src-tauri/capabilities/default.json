{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: app commands, native save/open dialogs, writing to paths the user picked, and opening only the project's own public pages.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://ataturk-mtal.github.io/*" },
        { "url": "https://github.com/Ataturk-MTAL/*" }
      ]
    }
  ]
}
