{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiskPrime",
  "version": "../package.json",
  "identifier": "tr.k12.ataturkmtal.riskprime",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "RiskPrime — İSG Risk Değerlendirmesi",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Atatürk MTAL Elektrik-Elektronik Teknolojisi Alanı",
    "category": "Education",
    "shortDescription": "Okullar için İSG risk değerlendirmesi",
    "windows": {
      "nsis": { "languages": ["Turkish", "English"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
